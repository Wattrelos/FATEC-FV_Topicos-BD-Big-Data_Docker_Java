# ==============================================================================
# Configuração do Ambiente Docker2 (Java Spring Boot) - Modelo de Variáveis
# Copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Seleção do Banco de Dados Ativo
# ------------------------------------------------------------------------------
# Opção 1: MariaDB 10 LTS + phpMyAdmin (Recomendado)
COMPOSE_FILE=docker-compose.yml:docker-compose.mariadb.yml

# Opção 2: PostgreSQL 16 + pgAdmin 4 (Suportado)
# COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml

# ------------------------------------------------------------------------------
# 2. Aplicação Backend Spring Boot
# ------------------------------------------------------------------------------
APP_PORT=8090

# ------------------------------------------------------------------------------
# 3. Credenciais e Parâmetros do Banco de Dados Relacional
# (Compartilhadas entre MariaDB e PostgreSQL para manter padrão)
# ------------------------------------------------------------------------------
DB_NAME=teste
DB_USER=root
DB_PASSWORD=userPassword
DB_ROOT_PASSWORD=rootPassword

# Portas dos Bancos de Dados no Host
MARIADB_PORT=3308
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 4. Interfaces Web de Gerenciamento dos Bancos de Dados
# ------------------------------------------------------------------------------
# phpMyAdmin (MariaDB)
PMA_PORT=5657
PMA_UPLOAD_LIMIT=64M

# pgAdmin 4 (PostgreSQL)
PGADMIN_PORT=5658
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=yourpassword

# ------------------------------------------------------------------------------
# 5. Cache em Memória (Redis)
# ------------------------------------------------------------------------------
REDIS_PORT=6380

# ------------------------------------------------------------------------------
# 6. Mensageria e Filas (RabbitMQ)
# ------------------------------------------------------------------------------
RABBITMQ_USER=user
RABBITMQ_PASS=password
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
